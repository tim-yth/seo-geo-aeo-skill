      "applicationCategory": "{同上}",
      "operatingSystem": "Web",
      "inLanguage": "zh-TW",
      "isAccessibleForFree": true,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "{CURRENCY}" },
      "provider": { "@type": "Organization", "@id": "https://example.com/#organization", "name": "{BRAND_NAME}", "url": "https://example.com/" },
      "mainEntityOfPage": "https://example.com/{tool}/"
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": "https://example.com/{tool}/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "{來自 GSC 真實查詢的問題}",
          "acceptedAnswer": { "@type": "Answer", "text": "{第一句直接回答}" }
        }
      ]
    }
  ],
  "entityPage": [
    {
      "@context": "https://schema.org",
      "@type": "Article",
