      "publisher": { "@type": "Organization", "@id": "https://example.com/#organization", "name": "{BRAND_NAME}", "url": "https://example.com/" },
      "mainEntityOfPage": "https://example.com/glossary/{slug}",
      "datePublished": "{YYYY-MM-DD}",
