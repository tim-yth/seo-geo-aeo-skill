      "url": "https://example.com/glossary/{slug}",
      "image": "https://example.com/images/{slug}.webp",
      "inDefinedTermSet": { "@type": "DefinedTermSet", "name": "{詞彙表名}", "url": "https://example.com/glossary/" },
      "termCode": "{slug}"
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": "https://example.com/glossary/{slug}#faq",
